---
---

<section class="section section-alt" id="overview" aria-labelledby="overview-title">
  <div class="container">

    <div class="overview-grid">
      <!-- Left: philosophy text -->
      <div class="overview-text">
        <div class="section-label" data-animate>核心理念</div>
        <h2 class="section-title" id="overview-title" data-animate data-delay="1">
          最小干预，<br />最大自动化
        </h2>
        <p class="overview-lead" data-animate data-delay="2">
          传统开发流程中，工程师花费大量时间在机械重复的工作上。<strong>Jarvis</strong> 重新定义了人机协作的边界。
        </p>
        <p class="overview-body" data-animate data-delay="3">
          AI 负责拆解任务、编写代码、运行测试、处理失败——人类只在三个关键节点介入：
          需求确认、高风险操作审批、持续失败处理。
        </p>
        <p class="overview-body" data-animate data-delay="3">
          干预是局部暂停，不是全局停机。其他任务继续并行推进。
        </p>

        <!-- Role cards -->
        <div class="role-cards" data-animate data-delay="4">
          <div class="role-card role-human">
            <div class="role-icon" aria-hidden="true">👤</div>
            <div>
              <div class="role-title">人类角色</div>
              <div class="role-desc">决策者 · 需求输入者 · 关键节点审批者 · 最终验收者</div>
            </div>
          </div>
          <div class="role-card role-ai">
            <div class="role-icon" aria-hidden="true">⚡</div>
            <div>
              <div class="role-title">AI 角色</div>
              <div class="role-desc">任务分解者 · 开发执行者 · 代码审查者 · 失败反思者</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: visual pipeline -->
      <div class="overview-visual" data-animate data-delay="2">
        <div class="pipeline">
          <div class="pipeline-step">
            <div class="pipeline-icon pipeline-icon-blue" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
              </svg>
            </div>
            <div class="pipeline-content">
              <div class="pipeline-label">需求输入</div>
              <div class="pipeline-desc">文字 · 飞书文档 · 原型图</div>
            </div>
          </div>

          <div class="pipeline-connector" aria-hidden="true"></div>

          <div class="pipeline-step">
            <div class="pipeline-icon pipeline-icon-purple" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 8v4l3 3"/>
              </svg>
            </div>
            <div class="pipeline-content">
              <div class="pipeline-label">AI 自动执行</div>
              <div class="pipeline-desc">任务拆解 → DAG → 并行开发</div>
            </div>
          </div>

          <div class="pipeline-connector" aria-hidden="true"></div>

          <div class="pipeline-step pipeline-step-highlight">
            <div class="pipeline-icon pipeline-icon-amber" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div class="pipeline-content">
              <div class="pipeline-label">关键节点人工介入</div>
              <div class="pipeline-desc">3 个场景 · 局部暂停 · 不中断全局</div>
            </div>
            <div class="pipeline-tag">最小干预</div>
          </div>

          <div class="pipeline-connector" aria-hidden="true"></div>

          <div class="pipeline-step">
            <div class="pipeline-icon pipeline-icon-green" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <div class="pipeline-content">
              <div class="pipeline-label">交付</div>
              <div class="pipeline-desc">代码审查 · Push · MR 创建</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  @media (max-width: 900px) {
    .overview-grid { grid-template-columns: 1fr; }
    .overview-visual { order: -1; }
  }

  .overview-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }

  .overview-lead strong { color: var(--primary-light); font-weight: 600; }

  .overview-body {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-3);
  }

  /* Role Cards */
  .role-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .role-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-card);
  }

  .role-icon { font-size: 1.25rem; flex-shrink: 0; margin-top: 1px; }

  .role-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .role-desc { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.5; }

  .role-human { border-color: rgba(99, 102, 241, 0.2); }
  .role-ai { border-color: rgba(34, 211, 238, 0.2); }

  /* Pipeline */
  .pipeline {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  .pipeline-step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    position: relative;
    transition: background 0.2s;
  }

  .pipeline-step:hover { background: rgba(255,255,255,0.03); }

  .pipeline-step-highlight {
    background: rgba(251, 191, 36, 0.04);
    border: 1px solid rgba(251, 191, 36, 0.15);
  }

  .pipeline-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pipeline-icon-blue { background: rgba(99,102,241,0.15); color: var(--primary-light); }
  .pipeline-icon-purple { background: rgba(139,92,246,0.15); color: var(--secondary); }
  .pipeline-icon-amber { background: rgba(251,191,36,0.12); color: var(--accent-amber); }
  .pipeline-icon-green { background: rgba(52,211,153,0.12); color: var(--accent-green); }

  .pipeline-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .pipeline-desc { font-size: 0.8125rem; color: var(--text-muted); }

  .pipeline-tag {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.25);
    color: var(--accent-amber);
    letter-spacing: 0.02em;
  }

  .pipeline-connector {
    width: 1px;
    height: 20px;
    background: var(--border);
    margin: 0 0 0 calc(var(--space-4) + 18px);
  }
</style>
