---
const phases = [
  {
    id: 'Phase 0',
    title: 'gitlab-webhook + claude-executor',
    status: 'done',
    items: [
      'GitLab Webhook 事件接入',
      'Claude Code 进程池管理',
      '基础会话和队列控制',
      '超时与重启机制',
    ],
  },
  {
    id: 'Phase 1',
    title: 'jarvis-core 核心骨架',
    status: 'wip',
    items: [
      '需求管理引擎（六维澄清 + 状态机）',
      '任务 DAG 构建与调度',
      '事件驱动 Scheduler',
      '状态观察者系统（observer）',
    ],
  },
  {
    id: 'Phase 2',
    title: 'Web UI 全功能',
    status: 'planning',
    items: [
      'DAG 可视化交互',
      '审批流页面',
      '实时执行监控（SSE）',
      '任务详情与执行历史',
    ],
  },
  {
    id: 'Phase 3',
    title: '智能重试 + 通知 + 审批',
    status: 'todo',
    items: [
      'Retry 四级模型实现',
      'AI Reflection 自我分析',
      'Feishu Bot 消息推送',
      '高风险操作审批流',
    ],
  },
  {
    id: 'Phase 4',
    title: '数据统计与分析',
    status: 'todo',
    items: [
      '交付周期分析',
      'AI 执行成功率',
      '重试率与干预频率',
      '工程效能仪表板',
    ],
  },
  {
    id: 'Phase 5',
    title: '水平扩展',
    status: 'todo',
    items: [
      '多执行器架构',
      '任务队列分布式化',
      '高可用部署',
      '性能优化',
    ],
  },
];

const statusMap = {
  done: { label: '已完成', class: 'badge-green' },
  wip: { label: '开发中', class: 'badge-blue' },
  planning: { label: '规划中', class: 'badge-amber' },
  todo: { label: '待开始', class: 'badge-muted' },
};
---

<section class="section section-alt" id="roadmap" aria-labelledby="roadmap-title">
  <div class="container">
    <div class="section-header">
      <div class="section-label" data-animate>开发路线图</div>
      <h2 class="section-title" id="roadmap-title" data-animate data-delay="1">从雏形到成熟平台</h2>
      <p class="section-desc" data-animate data-delay="2">
        六个阶段逐步构建完整的 AI 工程交付能力，每个阶段都有独立的交付价值。
      </p>
    </div>

    <div class="roadmap-grid">
      {phases.map((phase, i) => {
        const status = statusMap[phase.status];
        return (
          <article
            class={`roadmap-card card ${phase.status === 'done' ? 'roadmap-card-done' : ''}`}
            data-animate
            data-delay={String((i % 3) + 1)}
          >
            <div class="roadmap-header">
              <div class="roadmap-phase-id">{phase.id}</div>
              <span class={`badge ${status.class}`}>{status.label}</span>
            </div>
            <h3 class="roadmap-title">{phase.title}</h3>
            <ul class="roadmap-items">
              {phase.items.map(item => (
                <li class="roadmap-item">
                  <span class={`item-check ${phase.status === 'done' ? 'item-check-done' : ''}`} aria-hidden="true">
                    {phase.status === 'done' ? '✓' : '○'}
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>

    <!-- Progress bar -->
    <div class="roadmap-progress" data-animate>
      <div class="progress-header">
        <span class="progress-label">总体进度</span>
        <span class="progress-fraction">1 / 6 已完成</span>
      </div>
      <div class="progress-bar" role="progressbar" aria-valuenow={17} aria-valuemin={0} aria-valuemax={100} aria-label="开发进度 17%">
        <div class="progress-fill" style="width: 17%"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .roadmap-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .roadmap-card-done {
    background: rgba(52, 211, 153, 0.04) !important;
    border-color: rgba(52, 211, 153, 0.15) !important;
  }

  .roadmap-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .roadmap-phase-id {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .roadmap-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .roadmap-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .roadmap-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .item-check {
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-shrink: 0;
    margin-top: 2px;
    width: 14px;
    text-align: center;
  }

  .item-check-done { color: var(--accent-green); }

  /* Progress */
  .roadmap-progress {
    max-width: 480px;
    margin: 0 auto;
  }

  .progress-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .progress-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .progress-fraction {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .progress-bar {
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: var(--radius-full);
    transition: width 1s ease;
  }
</style>
