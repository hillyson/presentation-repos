---
const phases = [
  // ─────────── M1 · 初版闭环（已完成） ───────────
  {
    id: 'Phase 0',
    milestone: 'M1',
    title: 'gitlab-webhook + claude-executor',
    status: 'done',
    items: [
      'GitLab Webhook 事件接入 + 规则引擎',
      'Claude Code 进程池 + 会话复用',
      '任务队列与超时控制',
      'HTTP 通信骨架',
    ],
  },
  {
    id: 'Phase 0.5',
    milestone: 'M1',
    title: 'AI Code Review',
    status: 'done',
    items: [
      'MR/Push 事件驱动自动审查',
      '智能 diff 过滤（跳过生成文件/依赖锁）',
      '项目白名单正则匹配',
      'Bot 评论隐藏标签 + 自动清理',
    ],
  },
  {
    id: 'Phase 1',
    milestone: 'M1',
    title: 'jarvis-core 核心骨架（迭代 0+1）',
    status: 'done',
    items: [
      '需求管理 + 状态机流转',
      'task_index / task_dag_edges 持久化',
      '事件驱动 + 轮询 Scheduler',
      'observer StateEvent 总线',
    ],
  },
  {
    id: 'Phase 1.5',
    milestone: 'M1',
    title: 'AI 需求拆解 + DAG 确认门（迭代 2）',
    status: 'done',
    items: [
      'decomposer：prompt 构建 + LLM 调用',
      'Schema 校验 + DAG 无环检测',
      'pending_confirm 确认 / 拒绝门控',
      'Web UI → core 完整拆解链路',
    ],
  },
  {
    id: 'Phase 2',
    milestone: 'M1',
    title: '执行闭环（迭代 3）',
    status: 'done',
    items: [
      'executor 结果回调 jarvis-core',
      'gitlab-webhook 事件路由到 core',
      'GitLab Child Task 集成',
      '调度 → 执行 → 回调完整链路',
    ],
  },
  {
    id: 'Phase 3',
    milestone: 'M1',
    title: '智能重试 + 高风险审批（迭代 4）',
    status: 'done',
    items: [
      'L0~L3 四级重试状态机',
      'L1 上下文重试 prompt 构建',
      'L2 Reflection 回写 prompt / DAG',
      'execution intent 二段式 + 审批门控',
    ],
  },
  {
    id: 'Phase 4',
    milestone: 'M1',
    title: 'GitLab 双向同步（迭代 5）',
    status: 'done',
    items: [
      'Issue 标签全状态同步',
      'GitLab API 扩展（Update/Close/SetLabel）',
      'webhook 事件驱动反向同步',
      'StateEvent Bus + SSE 推送',
    ],
  },
  {
    id: 'Phase 5',
    milestone: 'M1',
    title: '前端真实数据 + 作业监控（迭代 7）',
    status: 'done',
    items: [
      'DAG 可视化 + 作业监控',
      'Workplace 管理（性能 8.2s→0.5s）',
      '统计报表（KPI + 双维度分析）',
      '一键启动脚本',
    ],
  },
  // ─────────── M2 · 生产级自动化 ───────────
  {
    id: 'Phase 6',
    milestone: 'M2',
    title: '多 Workplace 真实调度（迭代 8）',
    status: 'planning',
    note: '当前单 executor 可满足需求，已主动暂缓避免过早增复杂度',
    items: [
      'Executor 路由：按 WorkplaceID 动态选 URL',
      'Workplace 分配策略 + repo 亲和性',
      '多 Executor 健康检查 + 熔断降级',
      'Session resume 真实性验证',
    ],
  },
  {
    id: 'Phase 7',
    milestone: 'M2',
    title: '研发过程质量门 L1-L4（迭代 9）',
    status: 'done',
    items: [
      'L1 verify 软门 + project-rules.yaml 配置',
      'L2 Executor 自检 + evidence_mismatch 反幻觉',
      'L3 <review_verdict> 结构化 + l3_retry_count',
      'L4 pipeline-status callback + 质量门 KPI',
    ],
  },
  {
    id: 'Phase 8',
    milestone: 'M2',
    title: '需求级验收独立增强（迭代 10）',
    status: 'done',
    items: [
      'final verify-* DAG 节点作为验收入口',
      'acceptance run 三表落地 + lifecycle service',
      'Planner / Runner / Adjudicator 三段执行',
      'WebUI 验收中心 + Analytics 健康度指标',
    ],
  },
  {
    id: 'Phase 9',
    milestone: 'M2',
    title: '审批 / Reflection 端到端闭环（迭代 11）',
    status: 'done',
    items: [
      '高风险审批 → 移除 blocked → 任务恢复',
      'reject 语义：cancel + 下游级联取消',
      'L2 Reflection 同步决策路径',
      '审批操作完整审计链',
    ],
  },
  {
    id: 'Phase 10',
    milestone: 'M2',
    title: 'WebUI SSE 实时化（迭代 12）',
    status: 'done',
    items: [
      'SSEBroker 15s heartbeat 防长连接断',
      '全局单 EventSource + 多 handler 解耦',
      'DAG 局部更新 + 重连全量补齐',
      '审批 toast + 侧边栏未读计数',
    ],
  },
  {
    id: 'Phase 11',
    milestone: 'M2',
    title: 'GitLab 一体化本地体验（迭代 13）',
    status: 'done',
    items: [
      '一键 ./start-webui.sh --full 启动 6 服务',
      'webhook → core → DB 端到端验证',
      'GitLab 事件幂等（重复投递 no-op）',
      'GitLab MR 漂移 reconciler',
    ],
  },
  {
    id: 'Phase 12',
    milestone: 'M2',
    title: 'AI 作业管理（迭代 16）',
    status: 'done',
    items: [
      'AIJob 一等公民 + 四来源统一观测',
      'stream-json 解析精确 token & cost',
      '两步法终止（SIGTERM → 5s → SIGKILL）',
      'ai_jobs / ai_job_events 双表 + SSE 推送',
    ],
  },
  {
    id: 'Phase 13',
    milestone: 'M2',
    title: 'DAG 编辑协作 + 流程可见性（迭代 17）',
    status: 'done',
    items: [
      'AI 对话调整 DAG（pending_confirm/ready）',
      'PRD 合并 preview / apply 双步落库',
      '需求列表"流程"列文案',
      'LLM 作业终态对齐（消除 CLI 假完成）',
    ],
  },
  {
    id: 'Phase 14',
    milestone: 'M2',
    title: 'AIJob attempt 跟踪 + 僵尸恢复（迭代 18）',
    status: 'done',
    items: [
      'attempt_id 区分多次执行（同 task 多条 AIJob）',
      'reconcile 每分钟扫描陈旧 running 任务',
      'AIJob 终态回写 OnSucceeded / OnFailed',
      'RecoverStuckScheduled 重置超时 scheduled',
    ],
  },
];

const statusMap = {
  done: { label: '已完成', class: 'badge-green' },
  wip: { label: '进行中', class: 'badge-blue' },
  planning: { label: '规划中', class: 'badge-amber' },
  todo: { label: '待开始', class: 'badge-muted' },
};

const milestoneMap = {
  M1: { label: 'M1 · 初版闭环', color: 'green' },
  M2: { label: 'M2 · 生产级自动化', color: 'amber' },
};
---

<section class="section section-alt" id="roadmap" aria-labelledby="roadmap-title">
  <div class="container">
    <div class="section-header">
      <div class="section-label" data-animate>开发路线图</div>
      <h2 class="section-title" id="roadmap-title" data-animate data-delay="1">从雏形到成熟平台</h2>
      <p class="section-desc" data-animate data-delay="2">
        按两个里程碑推进：<strong>M1 初版闭环</strong>完成端到端打通；<strong>M2 生产级自动化</strong>引入多 Workplace、研发过程质量门 L1-L4、独立验收 L5、AI 作业一等公民化，实现"能自动完成高质量任务且全程可观测"。
      </p>
    </div>

    <!-- M1 Milestone -->
    <div class="milestone-section" data-animate>
      <div class="milestone-header milestone-header-green">
        <span class="milestone-label">M1 · 初版闭环</span>
        <span class="milestone-status">8 / 8 已完成</span>
      </div>
    </div>

    <div class="roadmap-grid">
      {phases.filter(p => p.milestone === 'M1').map((phase, i) => {
        const status = statusMap[phase.status];
        return (
          <article
            class={`roadmap-card card ${phase.status === 'done' ? 'roadmap-card-done' : ''}`}
            data-animate
            data-delay={String((i % 3) + 1)}
          >
            <div class="roadmap-header">
              <div class="roadmap-phase-id">{phase.id}</div>
              <span class={`badge ${status.class}`}>{status.label}</span>
            </div>
            <h3 class="roadmap-title">{phase.title}</h3>
            <ul class="roadmap-items">
              {phase.items.map(item => (
                <li class="roadmap-item">
                  <span class={`item-check ${phase.status === 'done' ? 'item-check-done' : ''}`} aria-hidden="true">
                    {phase.status === 'done' ? '✓' : '○'}
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            {phase.note && (
              <div class="roadmap-note">
                <span class="roadmap-note-icon" aria-hidden="true">ⓘ</span>
                {phase.note}
              </div>
            )}
          </article>
        );
      })}
    </div>

    <!-- M2 Milestone -->
    <div class="milestone-section" data-animate>
      <div class="milestone-header milestone-header-amber">
        <span class="milestone-label">M2 · 生产级自动化</span>
        <span class="milestone-status">迭代 9/10/11/12/13/16/17/18 已完成 · 8 暂缓</span>
      </div>
    </div>

    <div class="roadmap-grid">
      {phases.filter(p => p.milestone === 'M2').map((phase, i) => {
        const status = statusMap[phase.status];
        return (
          <article
            class={`roadmap-card card ${phase.status === 'done' ? 'roadmap-card-done' : ''}`}
            data-animate
            data-delay={String((i % 3) + 1)}
          >
            <div class="roadmap-header">
              <div class="roadmap-phase-id">{phase.id}</div>
              <span class={`badge ${status.class}`}>{status.label}</span>
            </div>
            <h3 class="roadmap-title">{phase.title}</h3>
            <ul class="roadmap-items">
              {phase.items.map(item => (
                <li class="roadmap-item">
                  <span class={`item-check ${phase.status === 'done' ? 'item-check-done' : ''}`} aria-hidden="true">
                    {phase.status === 'done' ? '✓' : '○'}
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            {phase.note && (
              <div class="roadmap-note">
                <span class="roadmap-note-icon" aria-hidden="true">ⓘ</span>
                {phase.note}
              </div>
            )}
          </article>
        );
      })}
    </div>

    <!-- Progress bar -->
    <div class="roadmap-progress" data-animate>
      <div class="progress-header">
        <span class="progress-label">总体进度</span>
        <span class="progress-fraction">M1 · 8/8 · M2 · 8/9（迭代 8 暂缓）</span>
      </div>
      <div class="progress-bar" role="progressbar" aria-valuenow={94} aria-valuemin={0} aria-valuemax={100} aria-label="开发进度 94%">
        <div class="progress-fill" style="width: 94%"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  /* Milestone section header */
  .milestone-section {
    margin-bottom: var(--space-4);
    margin-top: var(--space-4);
  }

  .milestone-section:first-of-type {
    margin-top: 0;
  }

  .milestone-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    border-left-width: 3px;
    gap: var(--space-3);
  }

  .milestone-header-green {
    border-left-color: var(--accent-green);
    background: rgba(52, 211, 153, 0.04);
  }

  .milestone-header-amber {
    border-left-color: var(--accent-amber);
    background: rgba(251, 191, 36, 0.04);
  }

  .milestone-label {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.02em;
  }

  .milestone-status {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .roadmap-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .roadmap-card-done {
    background: rgba(52, 211, 153, 0.04) !important;
    border-color: rgba(52, 211, 153, 0.15) !important;
  }

  .roadmap-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .roadmap-phase-id {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .roadmap-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .roadmap-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .roadmap-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .item-check {
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-shrink: 0;
    margin-top: 2px;
    width: 14px;
    text-align: center;
  }

  .item-check-done { color: var(--accent-green); }

  .roadmap-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: rgba(251, 191, 36, 0.06);
    border: 1px solid rgba(251, 191, 36, 0.15);
    font-size: 0.75rem;
    color: var(--accent-amber);
    line-height: 1.5;
  }

  .roadmap-note-icon {
    flex-shrink: 0;
    font-size: 0.875rem;
    line-height: 1;
    margin-top: 1px;
  }

  /* Progress */
  .roadmap-progress {
    max-width: 480px;
    margin: 0 auto;
  }

  .progress-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .progress-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .progress-fraction {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .progress-bar {
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: var(--radius-full);
    transition: width 1s ease;
  }
</style>
