---
const phases = [
  {
    id: 'Phase 0',
    title: 'gitlab-webhook + claude-executor',
    status: 'done',
    items: [
      'GitLab Webhook 事件接入 + 规则引擎',
      'Claude Code 进程池 + 会话复用',
      '任务队列与超时控制',
      'HTTP 通信骨架',
    ],
  },
  {
    id: 'Phase 0.5',
    title: 'AI Code Review',
    status: 'done',
    items: [
      'MR/Push 事件驱动自动审查',
      '智能 diff 过滤（跳过生成文件/依赖锁）',
      '项目白名单正则匹配',
      'Bot 评论隐藏标签 + 自动清理',
    ],
  },
  {
    id: 'Phase 1',
    title: 'jarvis-core 核心骨架',
    status: 'done',
    items: [
      '需求管理 + 状态机流转',
      'task_index / task_dag_edges 持久化',
      '事件驱动 + 轮询 Scheduler',
      'observer StateEvent 总线',
    ],
  },
  {
    id: 'Phase 1.5',
    title: 'AI 需求拆解 + DAG 确认门',
    status: 'done',
    items: [
      'decomposer：prompt 构建 + LLM 调用',
      'Schema 校验 + DAG 无环检测',
      'pending_confirm 确认 / 拒绝门控',
      'Web UI → core 完整拆解链路',
    ],
  },
  {
    id: 'Phase 2',
    title: '执行闭环（迭代 3）',
    status: 'done',
    items: [
      'executor 结果回调 jarvis-core',
      'gitlab-webhook 事件路由到 core',
      'GitLab Child Task 集成',
      '调度 → 执行 → 回调完整链路',
    ],
  },
  {
    id: 'Phase 3',
    title: '智能重试 + 高风险审批（迭代 4）',
    status: 'done',
    items: [
      'L0~L3 四级重试状态机',
      'L1 上下文重试 prompt 构建',
      'L2 Reflection 回写 prompt / DAG',
      'execution intent 二段式 + 审批门控',
    ],
  },
  {
    id: 'Phase 4',
    title: 'GitLab 双向同步 + 可观测性',
    status: 'wip',
    items: [
      'Issue 标签全状态同步（迭代 5 · 已完成）',
      'StateEvent Bus + SSE 推送（已完成）',
      '飞书推送通知（进行中）',
      'Prometheus 指标 + 结构化日志',
    ],
  },
  {
    id: 'Phase 5',
    title: '前端真实数据对接 + 水平扩展',
    status: 'planning',
    items: [
      'DAG 可视化 + 作业监控',
      'Workplace 管理 + 统计报表',
      '多 executor 水平扩展',
      '按规模评估消息队列解耦',
    ],
  },
];

const statusMap = {
  done: { label: '已完成', class: 'badge-green' },
  wip: { label: '进行中', class: 'badge-blue' },
  planning: { label: '规划中', class: 'badge-amber' },
  todo: { label: '待开始', class: 'badge-muted' },
};
---

<section class="section section-alt" id="roadmap" aria-labelledby="roadmap-title">
  <div class="container">
    <div class="section-header">
      <div class="section-label" data-animate>开发路线图</div>
      <h2 class="section-title" id="roadmap-title" data-animate data-delay="1">从雏形到成熟平台</h2>
      <p class="section-desc" data-animate data-delay="2">
        多阶段渐进构建完整的 AI 工程交付能力，每个阶段都有独立的交付价值。Phase 0 ~ Phase 3 已完成，当前推进 Phase 4。
      </p>
    </div>

    <div class="roadmap-grid">
      {phases.map((phase, i) => {
        const status = statusMap[phase.status];
        return (
          <article
            class={`roadmap-card card ${phase.status === 'done' ? 'roadmap-card-done' : ''}`}
            data-animate
            data-delay={String((i % 3) + 1)}
          >
            <div class="roadmap-header">
              <div class="roadmap-phase-id">{phase.id}</div>
              <span class={`badge ${status.class}`}>{status.label}</span>
            </div>
            <h3 class="roadmap-title">{phase.title}</h3>
            <ul class="roadmap-items">
              {phase.items.map(item => (
                <li class="roadmap-item">
                  <span class={`item-check ${phase.status === 'done' ? 'item-check-done' : ''}`} aria-hidden="true">
                    {phase.status === 'done' ? '✓' : '○'}
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>

    <!-- Progress bar -->
    <div class="roadmap-progress" data-animate>
      <div class="progress-header">
        <span class="progress-label">总体进度</span>
        <span class="progress-fraction">6 / 8 已完成 · 1 进行中</span>
      </div>
      <div class="progress-bar" role="progressbar" aria-valuenow={78} aria-valuemin={0} aria-valuemax={100} aria-label="开发进度 78%">
        <div class="progress-fill" style="width: 78%"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .roadmap-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .roadmap-card-done {
    background: rgba(52, 211, 153, 0.04) !important;
    border-color: rgba(52, 211, 153, 0.15) !important;
  }

  .roadmap-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .roadmap-phase-id {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .roadmap-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .roadmap-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .roadmap-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .item-check {
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-shrink: 0;
    margin-top: 2px;
    width: 14px;
    text-align: center;
  }

  .item-check-done { color: var(--accent-green); }

  /* Progress */
  .roadmap-progress {
    max-width: 480px;
    margin: 0 auto;
  }

  .progress-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .progress-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .progress-fraction {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .progress-bar {
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: var(--radius-full);
    transition: width 1s ease;
  }
</style>
