---
const features = [
  {
    icon: '🧩',
    title: 'AI 角色分离（4 职能解耦）',
    color: 'indigo',
    desc: 'Planner 拆解需求、Developer 实现代码、Reviewer 审 MR、Verifier 独立验收。四类角色在进程、workspace、模型、会话上完全隔离，打破"自己写自己验"的盲区。',
    tags: ['Planner-AI', 'Developer-AI', 'Reviewer-AI', 'Verifier-AI'],
  },
  {
    icon: '⬡',
    title: 'AI 需求拆解 + DAG 编排',
    color: 'blue',
    desc: 'decomposer 调用 Claude 将需求拆解为任务 DAG，经 Schema 校验和无环检测后进入 pending_confirm，人工确认后调度并行执行。',
    tags: ['Schema 校验', '无环检测', '并行执行', '局部隔离'],
  },
  {
    icon: '↻',
    title: '四级智能重试',
    color: 'purple',
    desc: '从即时重试到 AI Reflection 自我分析，再到人工兜底。Reflection 可产出新 prompt 或子任务拆解，运行时动态重构 DAG。',
    tags: ['L0 瞬时', 'L1 上下文', 'L2 Reflection', 'L3 人工介入'],
  },
  {
    icon: '✅',
    title: '独立验收阶段（L5 质量门）',
    color: 'green',
    desc: 'Verifier-AI 对主干代码逐条验证 accept_criteria，输出 pass / fail / uncertain 三类结构化结果；uncertain 自动转人工，避免 AI 自证循环。',
    tags: ['独立 Executor', '跨模型交叉验证', 'uncertain 转人工', '验收中心'],
  },
  {
    icon: '🔍',
    title: 'AI Code Review',
    color: 'cyan',
    desc: 'MR/Push 事件驱动自动审查，智能 diff 过滤跳过生成文件和依赖锁，Bot 评论隐藏标签确保每个 MR 只保留最新审查意见。',
    tags: ['MR 自动审查', 'Diff 过滤', '项目白名单', 'Bot 评论管理'],
  },
  {
    icon: '👁',
    title: 'AI 作业实时观测（AIJob 一等公民）',
    color: 'blue',
    desc: '每次 claude CLI 进程调用独立建模为 AIJob，统一覆盖四类来源：Task 调度 / Webhook 直连 / agent-loop 每轮 / resume 续跑。stream-json 解析精确 token & cost，SSE 实时推送，两步法终止（SIGTERM → 5s 宽限 → SIGKILL）保证 flush 与审计。同一任务的失败、重跑、成功通过 attempt_id 形成多条可追溯 AIJob。',
    tags: ['4 类来源', 'stream-json 解析', 'attempt 跟踪', '两步法终止'],
  },
  {
    icon: '✎',
    title: 'DAG 编辑协作 + PRD 合并预览（迭代 17）',
    color: 'purple',
    desc: 'pending_confirm / ready 阶段允许 AI 对话调整 DAG，已 dispatch/running/success 任务被 409 保护以保留执行历史。PRD 合并采用 preview / apply 双步：先返回每个维度的 diff，用户确认后才落库；需求列表"流程"列实时反映 webui status × core scheduling_status 组合状态。',
    tags: ['DAG 对话调整', 'PRD diff 预览', '执行历史保护', '流程列文案'],
  },
  {
    icon: '⚕',
    title: '僵尸任务恢复 + GitLab 漂移修复（迭代 18）',
    color: 'green',
    desc: 'reconcile 模块每分钟扫描陈旧 running 任务，按最新 AIJob 终态自动回写 OnSucceeded / OnFailed；scheduled 超时由 RecoverStuckScheduled 重置为 pending。GitLab drift reconciler 定期对账本地 mr_open 状态与 GitLab MR 实际状态，保守修复合并 / 关闭漂移，避免长期僵尸状态。',
    tags: ['Reconciler', 'AIJob 对账', '漂移修复', '保守恢复'],
  },
  {
    icon: '⚖',
    title: '缺陷裁决（severity × cost × scope）',
    color: 'amber',
    desc: '验收失败时，每个 defect 按三维度打分裁决：必修则自动回流开发、可接受则记入 known_issues、不可达则终止。修复循环封顶 2 次防死锁。',
    tags: ['severity', 'cost', 'scope', '循环封顶'],
  },
  {
    icon: '⚙',
    title: 'GitLab 为状态权威',
    color: 'indigo',
    desc: 'jarvis:* 前缀标签映射任务状态，webhook 双向同步；/jarvis approve 评论命令、标签变更、Issue 关闭均驱动内部状态流转。',
    tags: ['jarvis: 标签体系', '/jarvis 斜杠命令', 'Issue/MR 双向绑定'],
  },
  {
    icon: '📡',
    title: '事件驱动调度 + Workspace Lock',
    color: 'green',
    desc: '事件触发为主、10~30s 轮询兜底，确保任务不卡死。同一 repo 的任务通过 Workspace Lock 串行，避免并发写冲突；跨 repo 自由并行。',
    tags: ['事件驱动', '轮询兜底', 'Workspace Lock'],
  },
  {
    icon: '⚡',
    title: '最小干预设计',
    color: 'purple',
    desc: '四类场景触发人工介入：需求确认、高风险操作、持续失败、验收 uncertain。干预是局部暂停，不阻塞 DAG 中其他并行分支。',
    tags: ['需求确认', '风险审批', '失败兜底', '验收仲裁'],
  },
];
---

<section class="section section-alt" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-header">
      <div class="section-label" data-animate>核心能力</div>
      <h2 class="section-title" id="features-title" data-animate data-delay="1">专为 AI 工程设计</h2>
      <p class="section-desc" data-animate data-delay="2">
        每一个设计决策都服务于同一个目标：让 AI 在安全边界内自主完成尽可能多的工作。
      </p>
    </div>

    <div class="features-grid">
      {features.map((f, i) => (
        <article class={`feature-card feature-card-${f.color} card`} data-animate data-delay={String((i % 3) + 1)}>
          <div class={`feature-icon-wrap feature-icon-${f.color}`} aria-hidden="true">
            <span class="feature-icon-symbol">{f.icon}</span>
          </div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
          <div class="feature-tags">
            {f.tags.map(tag => (
              <span class="feature-tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Icon */
  .feature-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1.25rem;
    line-height: 1;
  }

  .feature-icon-blue { background: rgba(59,130,246,0.12); }
  .feature-icon-purple { background: rgba(139,92,246,0.12); }
  .feature-icon-amber { background: rgba(251,191,36,0.12); }
  .feature-icon-cyan { background: rgba(34,211,238,0.12); }
  .feature-icon-indigo { background: rgba(99,102,241,0.12); }
  .feature-icon-green { background: rgba(52,211,153,0.12); }

  .feature-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .feature-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .feature-tag {
    font-size: 0.75rem;
    padding: 3px 10px;
    border-radius: 4px;
    font-weight: 500;
    border: 1px solid transparent;
  }

  .feature-card-blue .feature-tag {
    background: rgba(59,130,246,0.1);
    color: #60a5fa;
    border-color: rgba(59,130,246,0.2);
  }

  .feature-card-purple .feature-tag {
    background: rgba(139,92,246,0.1);
    color: var(--secondary);
    border-color: rgba(139,92,246,0.2);
  }

  .feature-card-amber .feature-tag {
    background: rgba(251,191,36,0.1);
    color: var(--accent-amber);
    border-color: rgba(251,191,36,0.2);
  }

  .feature-card-cyan .feature-tag {
    background: rgba(34,211,238,0.1);
    color: var(--accent);
    border-color: rgba(34,211,238,0.2);
  }

  .feature-card-indigo .feature-tag {
    background: rgba(99,102,241,0.1);
    color: var(--primary-light);
    border-color: rgba(99,102,241,0.2);
  }

  .feature-card-green .feature-tag {
    background: rgba(52,211,153,0.1);
    color: var(--accent-green);
    border-color: rgba(52,211,153,0.2);
  }

  /* Card hover colors */
  .feature-card-blue:hover { border-color: rgba(59,130,246,0.3) !important; }
  .feature-card-purple:hover { border-color: rgba(139,92,246,0.3) !important; }
  .feature-card-amber:hover { border-color: rgba(251,191,36,0.2) !important; }
  .feature-card-cyan:hover { border-color: rgba(34,211,238,0.3) !important; }
  .feature-card-indigo:hover { border-color: rgba(99,102,241,0.35) !important; }
  .feature-card-green:hover { border-color: rgba(52,211,153,0.3) !important; }
</style>
