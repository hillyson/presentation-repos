---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 2L18 7V13L10 18L2 13V7L10 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <circle cx="10" cy="10" r="2.5" fill="currentColor"/>
        </svg>
        <span>JARVIS</span>
      </div>
      <p class="footer-tagline">AI 驱动的工程交付平台</p>
    </div>

    <div class="footer-links">
      <div class="footer-link-group">
        <div class="footer-link-heading">文档</div>
        <a href="#overview" class="footer-link">项目概览</a>
        <a href="#architecture" class="footer-link">架构设计</a>
        <a href="#features" class="footer-link">核心能力</a>
        <a href="#roadmap" class="footer-link">路线图</a>
      </div>

      <div class="footer-link-group">
        <div class="footer-link-heading">技术栈</div>
        <span class="footer-tech">Go · MySQL</span>
        <span class="footer-tech">Vue 3 · Vite</span>
        <span class="footer-tech">Claude Code</span>
        <span class="footer-tech">GitLab · Feishu</span>
      </div>

      <div class="footer-link-group">
        <div class="footer-link-heading">外部链接</div>
        <a
          href="https://claude.ai"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Claude AI
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span class="footer-copy">
        &copy; {year} Jarvis · Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="footer-astro-link">Astro</a>
      </span>
      <span class="footer-divider" aria-hidden="true">·</span>
      <span class="footer-copy">Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-900);
    padding-top: var(--space-16);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-16);
    padding-bottom: var(--space-12);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .footer-logo svg { color: var(--primary-light); }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Links */
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  @media (max-width: 500px) {
    .footer-links { grid-template-columns: 1fr 1fr; }
  }

  .footer-link-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link-heading {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-link:hover { color: var(--text-primary); }

  .footer-tech {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.04);
    padding: var(--space-4) 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-divider { color: var(--text-muted); }

  .footer-astro-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .footer-astro-link:hover { color: var(--text-secondary); }
</style>
