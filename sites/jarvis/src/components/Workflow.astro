---
const steps = [
  {
    num: '01',
    title: '录入需求',
    desc: '通过 Web UI 录入需求，支持纯文字描述或飞书文档链接。decomposer 模块自动解析并按六维度提取：基本信息、背景、描述、业务规则、技术上下文、验收标准。',
    color: 'blue',
    icon: '📝',
    note: '飞书文档 MCP 自动读取',
  },
  {
    num: '02',
    title: '六维结构化澄清（PRD 合并预览）',
    desc: 'LLM 针对缺失/模糊字段逐项发起多轮对话澄清，结合 choices 交互快速锁定关键信息。PRD 合并采用 preview / apply 双步：先返回每个维度的 diff，用户确认后才落库，防止模糊需求进入执行。',
    color: 'purple',
    icon: '🎯',
    note: 'LLM 对话 + choices + diff 预览',
  },
  {
    num: '03',
    title: 'AI 拆解 → DAG 确认门 → 协作编辑',
    desc: 'decomposer 调用 Claude 产出 Task JSON，校验 + 持久化全部放进 WithAskToolsValidate 钩子（迭代 17 终态对齐，消除"CLI 成功但 DAG 空"假完成）。pending_confirm / ready 阶段可通过 POST /requirements/:id/dag/chat 让 AI 对话调整 DAG，已 dispatch/running/success 任务被 409 保护。',
    color: 'indigo',
    icon: '⬡',
    note: 'Schema 校验 + 无环检测 + AI 对话编辑',
  },
  {
    num: '04',
    title: '事件驱动调度 + 多 Workplace 路由',
    desc: 'scheduler 以事件驱动为主、10~30s 轮询兜底，依据 task_dag_edges 解锁后继任务；同 repo 通过 Workspace Lock 串行，跨 repo 自由并行。workplace.Router 按 task.workplace_id 动态解析 executor URL，HealthChecker 派发前校验心跳/状态/熔断，不健康节点自动跳过。',
    color: 'primary',
    icon: '⚡',
    note: '事件主路径 + Router + 健康熔断',
  },
  {
    num: '05',
    title: 'Claude 执行 + 风险检测',
    desc: 'claude-executor 进程池驱动 Claude Code 执行，executor 模块二段式解析 execution intent；命中 risk_keywords 或 risk_level=high 触发审批门控。',
    color: 'cyan',
    icon: '🤖',
    note: 'mechanical / generative / destructive',
  },
  {
    num: '06',
    title: '智能重试四级模型',
    desc: 'L0 瞬时（超时/网络）→ L1 上下文（追加失败日志）→ L2 Reflection（产出新 prompt 或子任务，运行时改 DAG）→ L3 人工介入。',
    color: 'amber',
    icon: '↻',
    note: '阈值按 task_type 分档',
  },
  {
    num: '07',
    title: '人工干预（局部暂停）',
    desc: '三类触发：需求确认、高风险操作审批、反复失败。介入是状态转换而非系统暂停，未依赖该任务的并行分支继续推进。',
    color: 'amber',
    icon: '👤',
    note: '/jarvis approve · 局部暂停',
    isHuman: true,
  },
  {
    num: '08',
    title: 'AI Code Review（Reviewer-AI）',
    desc: 'MR 创建/更新或分支 push 触发 gitlab-webhook 异步审查：智能 diff 过滤跳过生成文件 + 项目白名单 + Bot 评论隐藏标签。审查输出末尾附带 <review_verdict> 结构化 JSON（verdict + issues 列表），core 通过 X-Jarvis-Secret 鉴权写入 task_reviews 与 task_index.review_verdict。',
    color: 'cyan',
    icon: '🔍',
    note: 'MR/Push 自动触发 + 结构化 verdict',
  },
  {
    num: '09',
    title: '独立验收阶段（Verifier-AI · L5）',
    desc: '所有开发 Task mr_merged 后触发 acceptance_run：独立 Verifier Executor 规划验收 → 逐条 accept_criterion 执行收集证据 → 输出 pass / fail / uncertain。可使用不同模型做跨模型交叉验证。',
    color: 'amber',
    icon: '✅',
    note: '独立 Executor · pass / fail / uncertain',
  },
  {
    num: '10',
    title: '缺陷裁决与修复回流',
    desc: '验收失败时按 severity × cost × scope 三维度矩阵裁决：必修 → 自动生成 fix 任务回流开发；可接受 → 记入 known_issues 放行；不可达 → 需求终止。修复循环封顶 2 次防死锁。',
    color: 'amber',
    icon: '⚖',
    note: '必修 / 接受 / 终止 · 循环封顶',
  },
  {
    num: '11',
    title: '交付（delivered）+ 漂移恢复',
    desc: 'Verifier 全条 pass 或"带已知问题放行"后需求进入 delivered；task_index 与 GitLab jarvis:* 标签双向同步，MR merged 释放 Workspace Lock，飞书推送验收报告。后台 reconcile 模块每分钟扫描陈旧 running 任务并对账最新 AIJob 终态，GitLab drift reconciler 修复 mr_open 漂移，避免僵尸状态滞留。',
    color: 'green',
    icon: '✓',
    note: 'delivered · 漂移修复 · 状态权威',
  },
];
---

<section class="section" id="workflow" aria-labelledby="workflow-title">
  <div class="container">
    <div class="section-header">
      <div class="section-label" data-animate>工作流程</div>
      <h2 class="section-title" id="workflow-title" data-animate data-delay="1">从需求到交付的完整链路</h2>
      <p class="section-desc" data-animate data-delay="2">
        每个步骤都有明确的输入、输出和质量关卡，AI 自主处理绝大多数场景，人类在关键节点把控方向。
      </p>
    </div>

    <div class="workflow-list">
      {steps.map((step, i) => (
        <div
          class={`workflow-step ${step.isHuman ? 'workflow-step-human' : ''}`}
          data-animate
          data-delay={String((i % 3) + 1)}
        >
          <div class="step-left">
            <div class={`step-num step-num-${step.color}`}>{step.num}</div>
            {i < steps.length - 1 && (
              <div class={`step-line step-line-${step.color}`} aria-hidden="true"></div>
            )}
          </div>

          <div class={`step-body step-body-${step.color}`}>
            <div class="step-header">
              <h3 class="step-title">{step.title}</h3>
              {step.isHuman && (
                <span class="step-badge-human">人工节点</span>
              )}
            </div>
            <p class="step-desc">{step.desc}</p>
            <div class="step-note">
              <span class="step-note-dot" aria-hidden="true"></span>
              {step.note}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .workflow-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .workflow-step {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-2);
  }

  .workflow-step-human .step-body {
    background: rgba(251, 191, 36, 0.04);
    border-color: rgba(251, 191, 36, 0.15);
  }

  /* Step Left */
  .step-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .step-num {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-mono);
    flex-shrink: 0;
    border: 1px solid;
  }

  .step-num-blue { background: rgba(59,130,246,0.1); color: #60a5fa; border-color: rgba(59,130,246,0.2); }
  .step-num-purple { background: rgba(139,92,246,0.1); color: var(--secondary); border-color: rgba(139,92,246,0.2); }
  .step-num-indigo { background: rgba(99,102,241,0.1); color: var(--primary-light); border-color: rgba(99,102,241,0.2); }
  .step-num-primary { background: rgba(99,102,241,0.15); color: var(--primary-light); border-color: rgba(99,102,241,0.3); }
  .step-num-amber { background: rgba(251,191,36,0.1); color: var(--accent-amber); border-color: rgba(251,191,36,0.2); }
  .step-num-cyan { background: rgba(34,211,238,0.1); color: var(--accent); border-color: rgba(34,211,238,0.2); }
  .step-num-green { background: rgba(52,211,153,0.1); color: var(--accent-green); border-color: rgba(52,211,153,0.2); }

  .step-line {
    width: 1px;
    flex: 1;
    min-height: 24px;
    margin: 4px 0;
  }

  .step-line-blue { background: linear-gradient(to bottom, rgba(59,130,246,0.3), transparent); }
  .step-line-purple { background: linear-gradient(to bottom, rgba(139,92,246,0.3), transparent); }
  .step-line-indigo { background: linear-gradient(to bottom, rgba(99,102,241,0.3), transparent); }
  .step-line-primary { background: linear-gradient(to bottom, rgba(99,102,241,0.3), transparent); }
  .step-line-amber { background: linear-gradient(to bottom, rgba(251,191,36,0.25), transparent); }
  .step-line-cyan { background: linear-gradient(to bottom, rgba(34,211,238,0.3), transparent); }
  .step-line-green { background: linear-gradient(to bottom, rgba(52,211,153,0.3), transparent); }

  /* Step Body */
  .step-body {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left-width: 3px;
    border-radius: var(--radius-md);
    padding: var(--space-6) var(--space-6);
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color 0.2s, background 0.2s;
  }

  .step-body:hover { background: var(--bg-card-hover); }

  .step-body-blue    { border-left-color: #3b82f6; }
  .step-body-purple  { border-left-color: var(--secondary); }
  .step-body-indigo  { border-left-color: var(--primary); }
  .step-body-primary { border-left-color: var(--primary-light); }
  .step-body-amber   { border-left-color: var(--accent-amber); }
  .step-body-cyan    { border-left-color: var(--accent); }
  .step-body-green   { border-left-color: var(--accent-green); }

  .step-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .step-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    flex: 1;
    margin: 0;
  }

  .step-badge-human {
    font-size: 0.6875rem;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: rgba(251,191,36,0.1);
    border: 1px solid rgba(251,191,36,0.25);
    color: var(--accent-amber);
    font-weight: 500;
    flex-shrink: 0;
  }

  .step-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .step-note {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--radius-full);
    padding: 3px 10px;
  }

  .step-note-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .step-body-blue    .step-note-dot { background: #3b82f6; }
  .step-body-purple  .step-note-dot { background: var(--secondary); }
  .step-body-indigo  .step-note-dot { background: var(--primary); }
  .step-body-primary .step-note-dot { background: var(--primary-light); }
  .step-body-amber   .step-note-dot { background: var(--accent-amber); }
  .step-body-cyan    .step-note-dot { background: var(--accent); }
  .step-body-green   .step-note-dot { background: var(--accent-green); }
</style>
